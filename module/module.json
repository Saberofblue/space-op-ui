{
  "id": "space-op-ui",
  "title": "FFG Star Wars Space Opera Ui",
  "description": "Overhauls the Foundry UI and  StarWarsFFG games. Based on a fork of LCARS UI. <p>*** Join the official Discord server: <a href=\"https://discord.gg/foundryvtt\"> Official Discord</a></p><p>*** Rejoignez la communauté Francophone: <a href=\"https://discord.gg/pPSDNJk\">Francophone Discord</a></p>",
  "authors": [
    {
      "name": "Sasmira",
      "email": "sasmyra@gmail.com",
      "url": "https://foundryvtt.com/community/sasmira",
      "flags": {}
    }
  ],
  "version": "14.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14.368"
  },
  "relationships": {
    "systems": [
      {
        "id": "starwarsffg",
        "type": "system",
        "manifest": "https://github.com/StarWarsFoundryVTT/StarWarsFFG/releases/latest/download/system.json",
        "compatibility": {
          "minimum": "2.0.0",
          "verified": "2.0.4"
        }
      },
      {
        "id": "starwarsffg_sandbox",
        "type": "system",
        "manifest": "https://github.com/Saberofblue/starwarsffg-sandbox/releases/latest/download/system.json",
        "compatibility": {
          "minimum": "2.0.4",
          "verified": "2.0.4.6"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/core.js"
  ],
  "styles": [
    "styles/compatibility.css",
    "styles/core.css"
  ],
  "media": [
    {
      "type": "setup",
      "caption": "Space Opera Ui",
      "thumbnail": "/modules/space-op-ui/artwork/space-opera-thumb.webp",
      "loop": false,
      "flags": {}
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    },
    {
      "lang": "fr",
      "name": "French (Français)",
      "path": "lang/fr.json",
      "flags": {}
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "json"
      ],
      "paths": [
        "styles/",
        "lang/"
      ]
    }
  },
  "url": "https://github.com/Saberofblue/space-op-ui",
  "manifest": "https://github.com/Saberofblue/space-op-ui/releases/latest/download/module.json",
  "download": "https://github.com/Saberofblue/space-op-ui/releases/download/14.0/module.zip"
}
